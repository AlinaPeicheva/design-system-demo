#!/usr/bin/env bash
set -euo pipefail

site_dir="${TMPDIR:-/tmp}/figma-make-design-system"
rm -rf "$site_dir"
mkdir -p "$site_dir"

sed 's#\.\./src/#src/#g' pages/dashboard.html > "$site_dir/index.html"
cp -R src "$site_dir/src"

exec python3 -m http.server "$PORT" --bind 0.0.0.0 --directory "$site_dir"
