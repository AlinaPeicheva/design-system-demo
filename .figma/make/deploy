#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"

sed 's#\.\./src/#src/#g' pages/dashboard.html > "$build_dir/index.html"
cp -R src "$build_dir/src"

[[ -d "$build_dir" ]] || {
  echo "Expected build output at $build_dir" >&2
  exit 1
}

figma make deploy --build-dir "$build_dir"
